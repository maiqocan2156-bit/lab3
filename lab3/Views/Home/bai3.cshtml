@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bài 3</title>

    <style>
        body {
            background-color: white;
            font-family: Arial;
        }

        #clock {
            width: 370px;
            height: 110px;
            background-color: black;
            color: #00cfff;
            font-size: 45px;
            text-align: center;
            line-height: 110px;
            margin: 50px auto;
        }
    </style>

    <script type="text/javascript">

        window.onload = function () {

            var clock = document.getElementById("clock");

            setInterval(function () {

                var d = new Date();

                var hour = d.getHours();
                var minute = d.getMinutes();
                var second = d.getSeconds();

                var ampm = "AM";

                if (hour >= 12) {
                    ampm = "PM";
                }

                if (hour > 12) {
                    hour = hour - 12;
                }

                if (hour == 0) {
                    hour = 12;
                }

                if (hour < 10) {
                    hour = "0" + hour;
                }

                if (minute < 10) {
                    minute = "0" + minute;
                }

                if (second < 10) {
                    second = "0" + second;
                }

                clock.innerHTML =
                    hour + ":" + minute + ":" + second + " " + ampm;

            }, 1000);
        }

    </script>
</head>

<body>

    <div id="clock"></div>

</body>
</html>