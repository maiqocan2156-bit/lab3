
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>vd5</title>
    <script type="text/javascript">
        function Respond() {
            var checkUni = document.getElementsByName("uni");
            if (checkUni[0].checked == true) {
                document.getElementById("huflit").innerHTML = " Tôi là sv khoa CNTT, trường Huflit"
            }
            if (checkUni[1].checked == true) {
                document.getElementById("huflit").innerHTML = " Tôi ko phải là sv khoa CNTT, trường Huflit"
            }
        }
    </script>
</head>
<body>
    <h4> Bạn có phải là 1 sv khoa CNTT trường Huflit ko</h4> 
    <input type="radio" name="uni" />Phải</br>
    <input type="radio" name="uni" />Không phải <br />
    <input type="submit" value="Trả lời" onclick="Respond();" /> Phải<br />
    <span id="huflit"></span>
</body>
</html>
